PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# service_role key is recommended for backend operations (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Optional anon public key
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# AI Vision Document OCR Configuration (for Purchase Bill Scanning)
# Recommended: Google Gemini Vision API (Free tier available at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-google-gemini-api-key

# Optional alternative: OpenAI Vision API
OPENAI_API_KEY=your-openai-api-key
